{
  "name": "kc-spineguard",
  "productName": "kc-spineguard",
  "private": true,
  "version": "1.1.0",
  "description": "kc-spineguard helps you manage sciatica: log pain, meds, stretches, posture, weight, mood, cognition and falls.",
  "author": "genidma",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:emu": "VITE_USE_EMULATORS=true vite --port=3000 --host=0.0.0.0",
    "emulators": "firebase emulators:start --only auth,firestore,functions --project demo-kc-spineguard",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:unit": "vitest run",
    "test": "playwright test",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "firebase": "^12.12.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-is": "^19.2.4",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "firebase-tools": "^15.36.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.4.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "uuid": "^11.1.1",
    "tar": "^7.5.3",
    "glob": "^14.0.6",
    "minimatch": "^11.0.1",
    "@opentelemetry/core": "^2.8.0"
  }
}
